{
  "buildCommand": "cd frontend && CI=false npx craco build",
  "installCommand": "cd frontend && yarn install",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.edm2n.com/$1",
      "permanent": true
    }
  ]
}
